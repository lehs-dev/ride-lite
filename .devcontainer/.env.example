# Copy this file to .devcontainer/.env and set unique local development passwords.
# SQL Server requires at least 8 characters from 3 of: uppercase, lowercase,
# digits, and symbols. Avoid ; in the SQL connection-string password.
MSSQL_SA_PASSWORD=
MONGO_ROOT_PASSWORD=
POSTGRES_PASSWORD=
# Change to 15432 if PostgreSQL already uses port 5432 on your machine.
POSTGRES_HOST_PORT=5432
RABBITMQ_PASSWORD=
