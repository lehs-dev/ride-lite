# Copy file này thành .agents/secrets.env rồi điền key thật.
# .agents/secrets.env đã được gitignore — KHÔNG commit key vào repo.

# Token Harbor (OpenAI-compatible). Nhiều key, cách nhau bởi dấu phẩy -> tự xoay khi gặp 429.
TOKEN_HARBOR_KEYS=thk_live_xxx...,thk_live_yyy...
TOKEN_HARBOR_BASE_URL=https://tokenharbor.ai/v1
DEEPSEEK_MODEL=deepseek-v4-flash:free

# NVIDIA (Llama 3.3 70B) cho bước review chéo.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
