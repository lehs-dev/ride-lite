{
  "Urls": "http://0.0.0.0:5000",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:3001",
      "http://localhost:5174",
      "http://127.0.0.1:5500"
    ]
  },
  "Authentication": {
    "Issuer": "SwiftRide",
    "Audience": "swiftride-api",
    "SecretKey": "SuperSecretKeyForDevelopmentAndTestingSwiftRide2026!@",
    "RequireHttpsMetadata": false
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "trip",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "admin-login": {
        "ClusterId": "trip",
        "RateLimiterPolicy": "admin-login-rate",
        "Match": {
          "Path": "/admin/auth/{**catch-all}"
        }
      },
      "admin-trips": {
        "ClusterId": "trip",
        "AuthorizationPolicy": "Admin",
        "RateLimiterPolicy": "admin-dashboard-rate",
        "Match": {
          "Path": "/admin/trips/{**catch-all}"
        }
      },
      "admin-users": {
        "ClusterId": "trip",
        "AuthorizationPolicy": "Admin",
        "RateLimiterPolicy": "admin-dashboard-rate",
        "Match": {
          "Path": "/admin/users/{**catch-all}"
        }
      },
      "admin-payments": {
        "ClusterId": "payment",
        "AuthorizationPolicy": "Admin",
        "RateLimiterPolicy": "admin-dashboard-rate",
        "Match": {
          "Path": "/admin/payments/{**catch-all}"
        }
      },
      "trips": {
        "ClusterId": "trip",
        "AuthorizationPolicy": "Authenticated",
        "RateLimiterPolicy": "rider-booking",
        "Match": {
          "Path": "/trips/{**catch-all}"
        }
      },
      "matching": {
        "ClusterId": "matching",
        "AuthorizationPolicy": "Authenticated",
        "RateLimiterPolicy": "rider-booking",
        "Match": {
          "Path": "/match/{**catch-all}"
        }
      },
      "quotes": {
        "ClusterId": "matching",
        "AuthorizationPolicy": "Authenticated",
        "RateLimiterPolicy": "rider-booking",
        "Match": {
          "Path": "/quote/{**catch-all}"
        }
      },
      "payments": {
        "ClusterId": "payment",
        "AuthorizationPolicy": "Authenticated",
        "RateLimiterPolicy": "payment",
        "Match": {
          "Path": "/payments/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "trip": {
        "Destinations": {
          "primary": {
            "Address": "http://trip-service:8080/"
          }
        }
      },
      "matching": {
        "Destinations": {
          "primary": {
            "Address": "http://matching-service:8080/"
          }
        }
      },
      "payment": {
        "Destinations": {
          "primary": {
            "Address": "http://payment-service:8080/"
          }
        }
      }
    }
  }
}
